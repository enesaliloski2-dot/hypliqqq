# Supabase (project settings → API). The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used in auth email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WalletConnect Cloud project id (optional; without it only injected/Coinbase/Phantom connectors are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Solana RPC endpoint for balance reads (optional; defaults to public mainnet-beta)
NEXT_PUBLIC_SOLANA_RPC=
# NEVER add SUPABASE_SERVICE_ROLE_KEY to this app. Admin roles are granted with SQL, see README.
